# Chintan Waste Operations Tracking System — copy this file to .env and fill it in.
# .env is git-ignored; this example is committed.

# The id in https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet must be shared as "Anyone with the link — Viewer" for reads to work.
VITE_SHEET_ID=

# The id in https://drive.google.com/drive/folders/<FOLDER_ID>
# Holds Documents/ and Photos/, created on first upload.
VITE_DRIVE_FOLDER_ID=

# Apps Script Web App URL, ending in /exec. See apps-script/README.md.
# Until this is set, no form can save anything.
VITE_SHEET_API_URL=

# Must match API_KEY in apps-script/Code.gs.
# Note: Vite inlines this into the built JS, so it is visible to anyone using the site.
VITE_SHEET_API_KEY=

# Minutes a fetched tab is reused before being fetched again.
VITE_CACHE_MINUTES=5

VITE_LOGO_URL=https://www.chintan-india.org/wp-content/uploads/2026/02/Chintan_Logo.jpg
